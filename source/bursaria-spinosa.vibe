        { id: "02_primary_boughs", position: [0.38, 1.35, -0.24], velocity: [0.14, 0.02, -0.06], radius: 0.18, inv_mass: 0.38 },
        { id: "03_leafy_spine_twigs", position: [-0.62, 1.85, 0.42], velocity: [0.28, 0.03, -0.10], radius: 0.22, inv_mass: 0.78 },
        { id: "04_flower_panicles", position: [0.48, 2.20, 0.36], velocity: [0.36, 0.04, -0.14], radius: 0.16, inv_mass: 0.95 }
