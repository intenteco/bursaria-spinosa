import "vibe:0.3/nquin" as nquin;
requires [capability("capability.invoke")];

// Bursaria spinosa Cav. (Sweet Bursaria / Blackthorn) — WEB-WP-15C
// Multi-stemmed woody native understorey shrub (2.2 m tall, ~2.0 m spread):
//   - Subterranean taproot (-1.35 m), fluted root collar, 6 lateral roots + 8 sinker roots + AMF mycelium
//   - 5 main stems (Order 0) -> 15 primary boughs (Order 1) -> 30 secondary limbs (Order 2) -> 40 spines/twigs (Order 3)
//   - Clustered obovate/wedge leaves, 10 pyramidal cream star-flower panicles & flat two-valved purse capsules.
