let surface_maps = capability.invoke("hypermedia.surface.synthesize_maps", {
    side: 256,
    seed: 92140,
    tint: [0.30, 0.24, 0.19],
    contrast: 0.34,
    relief: 0.006,
    bands: [28, 3],
    band_strength: 0.56,
    roughness: 0.62,
    metallic: 0.0
});
let surface_pbr_set = capability.invoke("hypermedia.surface.pack_pbr_set", {
    colour: surface_maps.colour,
    normal: surface_maps.normal,
    orm: surface_maps.orm
});
let pbr_10d = capability.invoke("hypermedia.manifold.compile_10d_pbr", {
    mesh: assembly.mesh,
    topology: true,
    spatial_index: true,
    camera_position: [2.8, 1.4, 3.2],
    camera_target: [0.0, 0.70, 0.0],
    camera_up: [0.0, 1.0, 0.0],
    camera_fov: 40.0,
    camera_near: 0.05
});

let substrate_m64 = capability.invoke("hypermedia.geodesy.compile_m64", {
    origin_lat_lon: [-35.29, 149.09],
    base_elevation_m: 610.0,
    grid_side: 16,
    record_mode: "strata",
    strokes: [
        { op: "raise", x: 8.0, y: 8.0, radius: 5.5, strength: 0.24, falloff: "gaussian" },
        { op: "smooth", x: 8.0, y: 8.0, radius: 7.0, strength: 0.30, falloff: "gaussian" }
    ]
});

let field_emf = capability.invoke("hypermedia.electromagnetics.compile_emf", {
    origin: [-1.8, -1.5, -1.8],
    voxel_size: 0.25,
    grid_dims: [3, 3, 3],
    epoch_s: 1700000000.0,
    sources: [
        { position: [0.0, 0.60, 0.0], e_amplitude: [2.4, 3.8, 1.5], wavelength_nm: 550.0, phase: 0.0, stokes: [0.18, 0.06, 0.0] },
        { position: [0.0, 0.90, 0.0], e_amplitude: [3.6, 2.8, 1.6], wavelength_nm: 850.0, phase: 0.35, stokes: [0.28, 0.10, 0.0] },
        { position: [0.0, -0.30, 0.0], e_amplitude: [1.4, 1.0, 1.8], wavelength_nm: 480.0, phase: 0.60, stokes: [0.08, 0.02, 0.0] }
    ],
    dipoles: [
        { position: [0.0, -0.28, 0.0], dipole_moment: [0.015, 0.028, -0.010], carrier_hz: 14.0, potential_v: -0.058, label: "rhizosphere_amf_waveguide_14hz" },
        { position: [0.0, 0.55, 0.0], dipole_moment: [0.012, 0.036, 0.010], carrier_hz: 2400000000.0, potential_v: 0.022, label: "canopy_rf_dielectric_attenuation" }
    ],
    constitutive: {
        epsilon_r: 16.0,
        mu_r: 1.0,
        conductivity_s_per_m: 0.072,
        model: "spiny_shrub_rhizosphere_par_nir_rf",
        label: "Bursaria spinosa taproot rhizosphere EMF & shrub canopy PAR/NIR profile"
    }
});
let spectral_slice = capability.invoke("hypermedia.electromagnetics.render_spectral_slice", {
    emf: field_emf, axis: "z", slice_index: 6, width: 256, height: 256, exposure: 1.5
});
let spectral_slice_png = capability.invoke("hypermedia.radiance.encode_rgba_png", { image: spectral_slice });

let xpbd_wind = capability.invoke("hypermedia.kinetics.step_island_xpbd", {
    bodies: [
        { id: "00_bursaria_taproot_collar", position: [0.0, -0.10, 0.0], velocity: [0.0, 0.0, 0.0], radius: 0.16, inv_mass: 0.0 },
        { id: "00_lateral_root_plate", position: [0.45, -0.24, -0.35], velocity: [0.0, 0.0, 0.0], radius: 0.32, inv_mass: 0.0 },
